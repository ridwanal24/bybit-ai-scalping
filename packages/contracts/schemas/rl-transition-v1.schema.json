{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "step": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "decision_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "action": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4
    },
    "mask": {
      "type": "array",
      "prefixItems": [
        {
          "type": "boolean",
          "const": true
        },
        {
          "type": "boolean"
        },
        {
          "type": "boolean"
        },
        {
          "type": "boolean"
        },
        {
          "type": "boolean"
        }
      ],
      "items": false,
      "minItems": 5,
      "maxItems": 5
    },
    "accepted": {
      "type": "boolean"
    },
    "next_time_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "observation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "next_observation_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "previous_equity": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "equity": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "reward_decimal": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "terminated": {
      "type": "boolean"
    },
    "truncated": {
      "type": "boolean"
    }
  },
  "required": [
    "step",
    "decision_ms",
    "action",
    "mask",
    "accepted",
    "next_time_ms",
    "observation_sha256",
    "next_observation_sha256",
    "previous_equity",
    "equity",
    "reward_decimal",
    "terminated",
    "truncated"
  ],
  "additionalProperties": false
}
