{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1"
    },
    "feature_schema_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "normalizer_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "configuration_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dataset_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "configuration_snapshot_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "source_configuration_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "string",
      "enum": [
        "fixture",
        "bybit-mainnet"
      ]
    },
    "symbol": {
      "type": "string"
    },
    "start_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "end_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rows": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "dimension": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "unavailable": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer",
        "minimum": 0,
        "maximum": 9007199254740991
      }
    },
    "context_label": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "context_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "files": {
      "minItems": 2,
      "maxItems": 2,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "file": {
            "type": "string",
            "enum": [
              "observations.f32",
              "decisions.jsonl"
            ]
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "file",
          "sha256"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "version",
    "feature_schema_hash",
    "normalizer_id",
    "configuration_hash",
    "dataset_fingerprint",
    "configuration_snapshot_id",
    "source_configuration_hash",
    "source",
    "symbol",
    "start_ms",
    "end_ms",
    "rows",
    "dimension",
    "unavailable",
    "context_label",
    "context_sha256",
    "files"
  ],
  "additionalProperties": false
}
