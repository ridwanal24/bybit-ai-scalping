{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1"
    },
    "algorithm": {
      "type": "string",
      "const": "welford_population_zscore_v1"
    },
    "numeric": {
      "type": "string",
      "const": "python_float64_decimal_strings_v1"
    },
    "feature_schema_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "configuration_hash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "dataset_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "string",
      "enum": [
        "fixture",
        "bybit-mainnet"
      ]
    },
    "symbol": {
      "type": "string",
      "pattern": "^[A-Z0-9]+USDT$"
    },
    "train_start_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "train_end_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "count": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "means": {
      "minItems": 1,
      "maxItems": 184,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 400,
        "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
      }
    },
    "scales": {
      "minItems": 1,
      "maxItems": 184,
      "type": "array",
      "items": {
        "type": "string",
        "maxLength": 400,
        "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
      }
    },
    "constant": {
      "minItems": 1,
      "maxItems": 184,
      "type": "array",
      "items": {
        "type": "boolean"
      }
    }
  },
  "required": [
    "version",
    "algorithm",
    "numeric",
    "feature_schema_hash",
    "configuration_hash",
    "dataset_fingerprint",
    "source",
    "symbol",
    "train_start_ms",
    "train_end_ms",
    "count",
    "means",
    "scales",
    "constant"
  ],
  "additionalProperties": false
}
