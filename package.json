{
  "name": "bybit-ai-scalping",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "workspaces": [
    "apps/api",
    "apps/web",
    "packages/contracts"
  ],
  "scripts": {
    "setup": "node scripts/tasks.mjs setup",
    "db:start": "node scripts/tasks.mjs db:start",
    "db:stop": "node scripts/tasks.mjs db:stop",
    "db:status": "node scripts/tasks.mjs db:status",
    "db:migrate": "node scripts/tasks.mjs db:migrate",
    "dev:api": "node scripts/tasks.mjs dev:api",
    "build": "node scripts/tasks.mjs build",
    "typecheck": "node scripts/tasks.mjs typecheck",
    "lint": "node scripts/tasks.mjs lint",
    "format": "prettier --write \"apps/{api,web}/**/*.{ts,tsx,json,css,html}\" \"packages/contracts/**/*.{ts,mjs}\" \"packages/contracts/{package,tsconfig}.json\" \"scripts/**/*.mjs\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"apps/{api,web}/**/*.{ts,tsx,json,css,html}\" \"packages/contracts/**/*.{ts,mjs}\" \"packages/contracts/{package,tsconfig}.json\" \"scripts/**/*.mjs\" \"*.{json,mjs}\"",
    "test": "node scripts/tasks.mjs test",
    "test:integration": "node scripts/tasks.mjs integration",
    "verify:foundation": "node scripts/tasks.mjs verify",
    "verify:configuration": "node scripts/tasks.mjs verify:configuration",
    "verify:market-data": "node scripts/tasks.mjs verify:market-data",
    "verify:features": "node scripts/tasks.mjs verify:features",
    "verify:simulation": "node scripts/tasks.mjs verify:simulation",
    "verify:baselines": "node scripts/tasks.mjs verify:baselines",
    "verify:environment": "node scripts/tasks.mjs verify:environment",
    "verify:training": "node scripts/tasks.mjs verify:training",
    "verify:evaluation": "node scripts/tasks.mjs verify:evaluation",
    "evaluation:register": "node scripts/tasks.mjs evaluation:register",
    "evaluation:run": "node scripts/tasks.mjs evaluation:run",
    "evaluation:report": "node scripts/tasks.mjs evaluation:report",
    "evaluation:freeze": "node scripts/tasks.mjs evaluation:freeze",
    "evaluation:holdout": "node scripts/tasks.mjs evaluation:holdout",
    "training:submit": "node scripts/tasks.mjs training:submit",
    "training:status": "node scripts/tasks.mjs training:status",
    "training:cancel": "node scripts/tasks.mjs training:cancel",
    "environment:run": "node scripts/tasks.mjs environment:run",
    "baseline:run": "node scripts/tasks.mjs baseline:run",
    "simulation:run": "node scripts/tasks.mjs simulation:run",
    "features:fit": "node scripts/tasks.mjs features:fit",
    "features:build": "node scripts/tasks.mjs features:build",
    "data:download": "node scripts/tasks.mjs data:download",
    "data:export": "node scripts/tasks.mjs data:export",
    "smoke:bybit-data": "node scripts/tasks.mjs smoke:bybit-data",
    "contracts:export": "node scripts/tasks.mjs contracts:export",
    "dev:dashboard": "node scripts/tasks.mjs dev:dashboard",
    "dev:web": "npm run dev -w @bybit/web",
    "verify:dashboard": "node scripts/tasks.mjs verify:dashboard"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.22",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "@swc/core@1.16.22": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
