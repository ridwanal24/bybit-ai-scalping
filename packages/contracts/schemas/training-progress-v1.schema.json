{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1"
    },
    "phase": {
      "type": "string",
      "enum": [
        "preparing",
        "training",
        "validation",
        "publishing",
        "finished"
      ]
    },
    "timesteps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "total_timesteps": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "rollouts": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "episode_count": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "valid_actions": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "elapsed_seconds": {
      "type": "number",
      "minimum": 0
    },
    "rss_mb": {
      "type": "number",
      "minimum": 0
    },
    "metrics": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "number"
      }
    }
  },
  "required": [
    "version",
    "phase",
    "timesteps",
    "total_timesteps",
    "rollouts",
    "episode_count",
    "valid_actions",
    "elapsed_seconds",
    "rss_mb",
    "metrics"
  ],
  "additionalProperties": false
}
