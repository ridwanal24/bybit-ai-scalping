{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1"
    },
    "source": {
      "type": "string",
      "enum": [
        "bybit-mainnet",
        "fixture"
      ]
    },
    "category": {
      "type": "string",
      "const": "linear"
    },
    "symbol": {
      "type": "string",
      "minLength": 5,
      "maxLength": 30,
      "pattern": "^[A-Z0-9]+USDT$"
    },
    "timestamp_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "rate": {
      "type": "string",
      "pattern": "^(?!-0(?:\\.0+)?$)-?(0|[1-9][0-9]{0,19})(\\.[0-9]{1,18})?$"
    }
  },
  "required": [
    "schema_version",
    "source",
    "category",
    "symbol",
    "timestamp_ms",
    "rate"
  ],
  "additionalProperties": false
}
