{
  "name": "bybit-ai-scalping",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.15 <25"
  },
  "workspaces": [
    "apps/api",
    "packages/contracts"
  ],
  "scripts": {
    "setup": "node scripts/tasks.mjs setup",
    "db:start": "node scripts/tasks.mjs db:start",
    "db:stop": "node scripts/tasks.mjs db:stop",
    "db:status": "node scripts/tasks.mjs db:status",
    "db:migrate": "node scripts/tasks.mjs db:migrate",
    "dev:api": "node scripts/tasks.mjs dev:api",
    "build": "node scripts/tasks.mjs build",
    "typecheck": "node scripts/tasks.mjs typecheck",
    "lint": "node scripts/tasks.mjs lint",
    "format": "prettier --write \"apps/api/**/*.{ts,json}\" \"packages/contracts/**/*.{ts,mjs}\" \"packages/contracts/{package,tsconfig}.json\" \"scripts/**/*.mjs\" \"*.{json,mjs}\"",
    "format:check": "prettier --check \"apps/api/**/*.{ts,json}\" \"packages/contracts/**/*.{ts,mjs}\" \"packages/contracts/{package,tsconfig}.json\" \"scripts/**/*.mjs\" \"*.{json,mjs}\"",
    "test": "node scripts/tasks.mjs test",
    "test:integration": "node scripts/tasks.mjs integration",
    "verify:foundation": "node scripts/tasks.mjs verify",
    "verify:configuration": "node scripts/tasks.mjs verify:configuration",
    "contracts:export": "node scripts/tasks.mjs contracts:export"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@swc/core": "1.16.22",
    "@types/node": "24.10.1",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "eslint": "10.14.0",
    "prettier": "3.9.10",
    "supertest": "7.3.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "unplugin-swc": "2.0.0",
    "vite": "8.3.6",
    "vitest": "5.1.0"
  },
  "allowScripts": {
    "@swc/core@1.16.22": true,
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
