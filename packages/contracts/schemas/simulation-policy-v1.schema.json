{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "simulation_policy_version": {
      "type": "string",
      "const": "restricted_bar_v1"
    },
    "acknowledge_research_only": {
      "type": "boolean",
      "const": true
    },
    "acknowledge_current_metadata": {
      "type": "boolean",
      "const": true
    },
    "acknowledge_declared_funding_schedule": {
      "type": "boolean",
      "const": true
    },
    "require_exchange_liquidation": {
      "type": "boolean",
      "const": false
    },
    "funding_price_proxy": {
      "type": "string",
      "const": "boundary_last_open"
    },
    "execution_latency_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 600000
    },
    "safety_reserve": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "funding_schedule": {
      "minItems": 1,
      "maxItems": 1000,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "start_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "end_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "interval_ms": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "anchor_ms": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "start_ms",
          "end_ms",
          "interval_ms",
          "anchor_ms"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "simulation_policy_version",
    "acknowledge_research_only",
    "acknowledge_current_metadata",
    "acknowledge_declared_funding_schedule",
    "require_exchange_liquidation",
    "funding_price_proxy",
    "execution_latency_ms",
    "safety_reserve",
    "funding_schedule"
  ],
  "additionalProperties": false
}
