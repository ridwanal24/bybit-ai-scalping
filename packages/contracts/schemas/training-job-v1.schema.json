{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1"
    },
    "job_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "state": {
      "type": "string",
      "enum": [
        "QUEUED",
        "RUNNING",
        "CANCELLING",
        "SUCCEEDED",
        "CANCELLED",
        "FAILED",
        "RESOURCE_LIMIT",
        "INTERRUPTED"
      ]
    },
    "created_at": {
      "type": "string"
    },
    "started_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "finished_at": {
      "type": [
        "string",
        "null"
      ]
    },
    "supervisor_pid": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "worker_pid": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "reason": {
      "anyOf": [
        {
          "type": "string",
          "maxLength": 100
        },
        {
          "type": "null"
        }
      ]
    },
    "model_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "progress": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "version": {
              "type": "string",
              "const": "1"
            },
            "phase": {
              "type": "string",
              "enum": [
                "preparing",
                "training",
                "validation",
                "publishing",
                "finished"
              ]
            },
            "timesteps": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "total_timesteps": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "rollouts": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "episode_count": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "valid_actions": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "elapsed_seconds": {
              "type": "number",
              "minimum": 0
            },
            "rss_mb": {
              "type": "number",
              "minimum": 0
            },
            "metrics": {
              "type": "object",
              "propertyNames": {
                "type": "string"
              },
              "additionalProperties": {
                "type": "number"
              }
            }
          },
          "required": [
            "version",
            "phase",
            "timesteps",
            "total_timesteps",
            "rollouts",
            "episode_count",
            "valid_actions",
            "elapsed_seconds",
            "rss_mb",
            "metrics"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    },
    "usage": {
      "anyOf": [
        {
          "type": "object",
          "properties": {
            "elapsed_seconds": {
              "type": "number",
              "minimum": 0
            },
            "sampled_peak_rss_mb": {
              "type": "number",
              "minimum": 0
            }
          },
          "required": [
            "elapsed_seconds",
            "sampled_peak_rss_mb"
          ],
          "additionalProperties": false
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "job_id",
    "state",
    "created_at",
    "started_at",
    "finished_at",
    "supervisor_pid",
    "worker_pid",
    "reason",
    "model_id",
    "progress",
    "usage"
  ],
  "additionalProperties": false
}
