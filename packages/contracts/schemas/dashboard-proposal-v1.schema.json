{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "model_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "target": {
      "type": "string",
      "const": "backtest"
    },
    "note": {
      "type": "string",
      "minLength": 8,
      "maxLength": 500
    },
    "acknowledge_research_only": {
      "type": "boolean",
      "const": true
    }
  },
  "required": [
    "model_id",
    "target",
    "note",
    "acknowledge_research_only"
  ],
  "additionalProperties": false
}
