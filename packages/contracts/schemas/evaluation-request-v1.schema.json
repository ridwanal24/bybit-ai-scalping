{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "type": "string",
      "const": "1"
    },
    "dataset_id": {
      "type": "string",
      "format": "uuid",
      "pattern": "^([0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89abAB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}|00000000-0000-0000-0000-000000000000|ffffffff-ffff-ffff-ffff-ffffffffffff)$"
    },
    "configuration_file": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "source_snapshot_file": {
      "anyOf": [
        {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096
        },
        {
          "type": "null"
        }
      ]
    },
    "policy": {
      "type": "object",
      "properties": {
        "simulation_policy_version": {
          "type": "string",
          "const": "restricted_bar_v1"
        },
        "acknowledge_research_only": {
          "type": "boolean",
          "const": true
        },
        "acknowledge_current_metadata": {
          "type": "boolean",
          "const": true
        },
        "acknowledge_declared_funding_schedule": {
          "type": "boolean",
          "const": true
        },
        "require_exchange_liquidation": {
          "type": "boolean",
          "const": false
        },
        "funding_price_proxy": {
          "type": "string",
          "const": "boundary_last_open"
        },
        "execution_latency_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 600000
        },
        "safety_reserve": {
          "type": "string",
          "maxLength": 300,
          "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
        },
        "funding_schedule": {
          "minItems": 1,
          "maxItems": 1000,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "start_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "end_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              "interval_ms": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "anchor_ms": {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              }
            },
            "required": [
              "start_ms",
              "end_ms",
              "interval_ms",
              "anchor_ms"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "simulation_policy_version",
        "acknowledge_research_only",
        "acknowledge_current_metadata",
        "acknowledge_declared_funding_schedule",
        "require_exchange_liquidation",
        "funding_price_proxy",
        "execution_latency_ms",
        "safety_reserve",
        "funding_schedule"
      ],
      "additionalProperties": false
    },
    "range_start_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "range_end_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "seeds": {
      "minItems": 3,
      "maxItems": 5,
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": 0,
        "maximum": 4294967295
      }
    },
    "folds": {
      "type": "integer",
      "minimum": 2,
      "maximum": 4
    },
    "purge_bars": {
      "type": "integer",
      "minimum": 1,
      "maximum": 60
    },
    "ablation": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "enum": [
            "log_return",
            "percentage_return",
            "body_ratio",
            "upper_wick_ratio",
            "lower_wick_ratio",
            "range_fraction",
            "close_location",
            "rolling_return",
            "ema_fast_distance",
            "ema_slow_distance",
            "ema_long_distance",
            "ema_spread",
            "ema_slope",
            "rsi",
            "macd_line",
            "macd_signal",
            "macd_histogram",
            "atr",
            "atr_fraction",
            "volatility",
            "volume_change",
            "relative_volume",
            "volume_ma_ratio"
          ]
        },
        "timeframe": {
          "type": "string",
          "enum": [
            "1m",
            "3m",
            "5m",
            "15m",
            "30m",
            "1h",
            "4h",
            "1D"
          ]
        }
      },
      "required": [
        "id",
        "timeframe"
      ],
      "additionalProperties": false
    },
    "train_timesteps": {
      "type": "integer",
      "minimum": 8,
      "maximum": 1000000
    },
    "n_steps": {
      "type": "integer",
      "minimum": 8,
      "maximum": 2048
    },
    "batch_size": {
      "type": "integer",
      "minimum": 2,
      "maximum": 9007199254740991
    },
    "ppo_epochs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10
    },
    "resources": {
      "type": "object",
      "properties": {
        "cpu_threads": {
          "type": "number",
          "const": 1
        },
        "max_wall_seconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "max_memory_mb": {
          "type": "integer",
          "minimum": 64,
          "maximum": 8192
        },
        "max_timesteps": {
          "type": "integer",
          "minimum": 8,
          "maximum": 1000000
        },
        "max_checkpoints": {
          "type": "integer",
          "minimum": 1,
          "maximum": 32
        }
      },
      "required": [
        "cpu_threads",
        "max_wall_seconds",
        "max_memory_mb",
        "max_timesteps",
        "max_checkpoints"
      ],
      "additionalProperties": false
    },
    "max_new_trainings": {
      "type": "integer",
      "minimum": 1,
      "maximum": 40
    },
    "max_total_train_steps": {
      "type": "integer",
      "minimum": 8,
      "maximum": 1000000
    },
    "suite_wall_seconds": {
      "type": "integer",
      "minimum": 30,
      "maximum": 3600
    },
    "suite_memory_mb": {
      "type": "integer",
      "minimum": 64,
      "maximum": 8192
    },
    "legacy_model_id": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "version",
    "dataset_id",
    "configuration_file",
    "source_snapshot_file",
    "policy",
    "range_start_ms",
    "range_end_ms",
    "seeds",
    "folds",
    "purge_bars",
    "ablation",
    "train_timesteps",
    "n_steps",
    "batch_size",
    "ppo_epochs",
    "resources",
    "max_new_trainings",
    "max_total_train_steps",
    "suite_wall_seconds",
    "suite_memory_mb",
    "legacy_model_id"
  ],
  "additionalProperties": false
}
