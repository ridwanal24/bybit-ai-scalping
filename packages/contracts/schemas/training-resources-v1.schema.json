{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "cpu_threads": {
      "type": "number",
      "const": 1
    },
    "max_wall_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "max_memory_mb": {
      "type": "integer",
      "minimum": 64,
      "maximum": 8192
    },
    "max_timesteps": {
      "type": "integer",
      "minimum": 8,
      "maximum": 1000000
    },
    "max_checkpoints": {
      "type": "integer",
      "minimum": 1,
      "maximum": 32
    }
  },
  "required": [
    "cpu_threads",
    "max_wall_seconds",
    "max_memory_mb",
    "max_timesteps",
    "max_checkpoints"
  ],
  "additionalProperties": false
}
