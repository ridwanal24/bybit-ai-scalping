{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "time_ms": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "phase": {
      "type": "string",
      "enum": [
        "open",
        "intrabar",
        "close",
        "terminal"
      ]
    },
    "wallet": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "equity": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "unrealized": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "initial_margin": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "available_margin": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "realized": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "fees": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "funding": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^-?(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "side": {
      "type": "string",
      "enum": [
        "FLAT",
        "LONG",
        "SHORT"
      ]
    },
    "quantity": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "reference_price": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "peak_equity": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "drawdown": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "day_start_equity": {
      "type": "string",
      "maxLength": 300,
      "pattern": "^(0|[1-9][0-9]*)(\\.[0-9]+)?$"
    },
    "daily_latched": {
      "type": "boolean"
    },
    "drawdown_latched": {
      "type": "boolean"
    }
  },
  "required": [
    "time_ms",
    "phase",
    "wallet",
    "equity",
    "unrealized",
    "initial_margin",
    "available_margin",
    "realized",
    "fees",
    "funding",
    "side",
    "quantity",
    "reference_price",
    "peak_equity",
    "drawdown",
    "day_start_equity",
    "daily_latched",
    "drawdown_latched"
  ],
